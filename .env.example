# Server
DATABASE_PATH=./data/app.sqlite
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL the app is served at (used for CORS + links in emails)
PUBLIC_APP_URL=http://localhost:5173

# Resend (magic-link auth emails)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=login@example.com

# Cloud vision API (receipt OCR) — both must be set to use a real provider;
# leave unset for local dev, which falls back to a filename-text heuristic
VISION_API_KEY=
VISION_PROVIDER=

# Where uploaded receipt images are stored on disk (defaults to ../../data/receipts,
# relative to apps/server's cwd — see PLAN.md Phase 8 for the Docker volume mapping)
RECEIPT_UPLOAD_DIR=

# Web app (Vite — must be prefixed VITE_ to be exposed to the client)
VITE_SERVER_URL=http://localhost:4000
