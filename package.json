{
  "name": "family-pool",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @family-pool/web dev",
    "dev:server": "pnpm --filter @family-pool/server dev",
    "db:generate": "pnpm --filter @family-pool/db generate",
    "db:migrate": "pnpm --filter @family-pool/db migrate",
    "db:seed": "pnpm --filter @family-pool/db seed",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "prettier": "^3.4.2"
  }
}
